PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://sih:sih@localhost:5432/sih_portal
REDIS_URL=redis://localhost:6379

# Clerk (FR-01, FR-02, FR-03, FR-04)
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...
# Local only: allow x-dev-user-id / x-dev-role headers when true
ALLOW_DEV_AUTH=true

# Resend (FR-13, FR-22, FR-23)
RESEND_API_KEY=re_...
RESEND_WEBHOOK_SECRET=whsec_...
RESEND_FROM_EMAIL=SIH Portal <noreply@prabodh.app>

# S3 / R2 (FR-16)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=sih-deliverables
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Comma-separated browser origins (required in production CORS)
# Comma-separated frontend origins (production + local dev)
APP_ORIGIN=https://prabodh-2.onrender.com,http://localhost:3000
# Used in invite emails (first origin wins if APP_ORIGIN is comma-separated)
NEXT_PUBLIC_APP_URL=https://prabodh-2.onrender.com

# Optional virus-scan webhook (S3 event -> ClamAV/Lambda). Empty = skip scan.
SCAN_WEBHOOK_URL=
SCAN_WEBHOOK_SECRET=

INVITE_RATE_LIMIT_PER_MIN=10
BROADCAST_RATE_LIMIT_PER_MIN=5
UPLOAD_RATE_LIMIT_PER_MIN=20
