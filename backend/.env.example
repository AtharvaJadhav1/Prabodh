PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://sih:sih@localhost:5432/sih_portal
REDIS_URL=redis://localhost:6379

# Auth — email OTP + JWT (required in production)
AUTH_JWT_SECRET=change-me-to-a-long-random-string
AUTH_JWT_TTL_SEC=604800
OTP_TTL_SEC=600
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_PER_MIN=5
# Local only: allow x-dev-user-id header when true
ALLOW_DEV_AUTH=true

# Resend (FR-13, FR-22, FR-23)
RESEND_API_KEY=re_...
RESEND_WEBHOOK_SECRET=whsec_...
RESEND_FROM_EMAIL=Prabodh <noreply@prabodh.app>
# Team & mentor invitation emails (verify invite.prabodh.app in Resend)
RESEND_INVITE_FROM_EMAIL=Prabodh <invite@prabodh.app>
# Auth OTP emails (prefer otp@ so Gmail Primary inbox filtering is more reliable)
RESEND_OTP_FROM_EMAIL=Prabodh <otp@prabodh.app>

# S3 / R2 (FR-16)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=sih-deliverables
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Comma-separated browser origins (required in production CORS)
# Comma-separated frontend origins (production + local dev)
APP_ORIGIN=https://incubation.prabodh.app,https://prabodh-2.onrender.com,http://localhost:3000
# Used in invite emails (first origin wins if APP_ORIGIN is comma-separated)
NEXT_PUBLIC_APP_URL=https://incubation.prabodh.app

# Optional virus-scan webhook (S3 event -> ClamAV/Lambda). Empty = skip scan.
SCAN_WEBHOOK_URL=
SCAN_WEBHOOK_SECRET=

INVITE_RATE_LIMIT_PER_MIN=10
BROADCAST_RATE_LIMIT_PER_MIN=5
UPLOAD_RATE_LIMIT_PER_MIN=20
