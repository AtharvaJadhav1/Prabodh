{
  "name": "sih-portal-backend",
  "version": "1.0.0",
  "private": true,
  "description": "SIH Team & Project Management Portal — Node.js API (BRD FR-01 to FR-27)",
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "render:build": "npm install --include=dev && npx prisma generate && npx prisma db push && npx tsx prisma/ensure-columns.ts && npx tsx prisma/seed.ts && npm run build",
    "prisma:ensure": "tsx prisma/ensure-columns.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "test": "tsx --test src/domain/rules.spec.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.709.0",
    "@aws-sdk/s3-request-presigner": "^3.709.0",
    "@clerk/backend": "^1.21.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^6.19.3",
    "@types/node": "^22.10.2",
    "@types/pdfkit": "^0.13.8",
    "bullmq": "^5.34.5",
    "exceljs": "^4.4.0",
    "ioredis": "^5.4.2",
    "pdfkit": "^0.15.2",
    "reflect-metadata": "^0.2.2",
    "resend": "^4.0.1",
    "rxjs": "^7.8.1",
    "svix": "^1.44.0",
    "typescript": "^5.7.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@types/express": "^5.0.0",
    "prisma": "^6.19.3",
    "tsx": "^4.19.2"
  }
}
