{
  "name": "prabodh-load-tests",
  "private": true,
  "description": "Artillery load tests for the Prabodh NestJS API",
  "scripts": {
    "smoke": "node scripts/run-with-token.js scenarios/smoke.yml reports/smoke.json",
    "load": "node scripts/run-with-token.js scenarios/load.yml reports/load.json",
    "stress": "node scripts/run-with-token.js scenarios/stress.yml reports/stress.json",
    "smoke:render": "cross-env TARGET=https://prabodh.onrender.com/api npm run smoke",
    "load:render": "cross-env TARGET=https://prabodh.onrender.com/api npm run load",
    "stress:render": "cross-env TARGET=https://prabodh.onrender.com/api npm run stress",
    "report:smoke": "artillery report reports/smoke.json --output reports/smoke.html"
  },
  "devDependencies": {
    "artillery": "^2.0.23",
    "cross-env": "^7.0.3"
  }
}
