NEXT_PUBLIC_API_URL=https://prabodh.onrender.com/api
NEXT_PUBLIC_APP_URL=https://prabodh-2.onrender.com

# Clerk — required for production auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login/student
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register

# Must be a PUBLIC route — wait for Clerk cookie before /dashboard
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/auth/callback
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/auth/callback
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/auth/callback
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/auth/callback

# Clerk Dashboard (required for OTP + production login):
# 1) Add https://prabodh-2.onrender.com to Allowed origins / redirect URLs
# 2) Enable Email verification code under User & authentication
# 3) Optional: custom SMTP via Resend (noreply@prabodh.app) so OTPs actually deliver
