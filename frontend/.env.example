# Backend origin used by Next.js /api rewrites. Include host only or host + /api.
NEXT_PUBLIC_API_URL=https://prabodh.onrender.com/api
# Optional server-only rewrite target (defaults to NEXT_PUBLIC_API_URL):
# API_URL=https://prabodh.onrender.com
NEXT_PUBLIC_APP_URL=https://incubation.prabodh.app

# Local full-stack dev (copy to .env.development.local):
# NEXT_PUBLIC_API_URL=http://localhost:3001/api
# NEXT_PUBLIC_APP_URL=http://localhost:3000
